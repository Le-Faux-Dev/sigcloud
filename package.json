{
  "name": "sig-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "SIG-Cloud : espace cloud de stockage, visualisation et partage de données géospatiales",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tmcw/togeojson": "^7.1.3",
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "axe-core": "^4.14.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "leaflet": "^1.9.4",
    "lucide-static": "^1.61.0",
    "prisma": "^7.10.1",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "dev": "node --env-file=.env server/src/server.js",
    "start": "node server/src/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "build:icons": "node scripts/build-icons.mjs",
    "build:vendor": "node scripts/copy-vendor.mjs",
    "build:css": "tailwindcss -i client/styles/input.css -o client/assets/app.css --minify",
    "build": "npm run prisma:generate && npm run build:icons && npm run build:vendor && npm run build:contours && npm run build:css",
    "create-admin": "node --env-file=.env scripts/create-admin.mjs",
    "lint": "eslint .",
    "check:html": "node scripts/check-html.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node --test \"server/tests/unit/**/*.test.js\"",
    "audit:deps": "npm audit --omit=dev",
    "build:contours": "node scripts/build-contours.mjs",
    "test:e2e": "node e2e/run.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  }
}
