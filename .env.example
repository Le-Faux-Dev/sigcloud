# SIG-Cloud : variables d'environnement. COPIE ce fichier en .env (ignoré par Git) et remplace les valeurs.
# Toutes les valeurs ci-dessous sont FICTIVES. Ne mets jamais de vrai secret dans ce fichier.
#   Windows PowerShell :  Copy-Item .env.example .env
#   Linux / macOS      :  cp .env.example .env

NODE_ENV=development
PORT=3000

# URL publique de l'application (sert à l'Origin autorisé et aux liens de partage)
APP_ORIGIN=http://localhost:3000
# Derrière Vercel : 1
TRUST_PROXY=0

# Secret maître (HMAC des IP, signature du stockage local). Génère-le :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=CHANGE_ME_remplace_par_au_moins_32_caracteres_aleatoires

# Base PostgreSQL (Neon). DATABASE_URL = URL POOLÉE (application) ; DIRECT_URL = URL DIRECTE (migrations Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/sigcloud
DIRECT_URL=postgresql://user:password@localhost:5432/sigcloud
DB_POOL_MAX=5

# Stockage : local (développement/tests uniquement) ou r2 (production)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=sig-cloud-private
# Optionnel : endpoint personnalisé (sinon https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# Limites (octets)
MAX_FILE_BYTES=52428800
DEFAULT_QUOTA_BYTES=1073741824
PREVIEW_MAX_BYTES=10485760
PART_SIZE_BYTES=8388608
SIGNED_URL_TTL_SECONDS=300
UPLOAD_URL_TTL_SECONDS=900

# Sessions
SESSION_TTL_DAYS=14

# Limitation de débit : memory (dev/tests) | postgres (prod simple) | upstash
RATE_LIMIT_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tâches planifiées (Vercel Cron envoie Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=CHANGE_ME_au_moins_32_caracteres_aleatoires

# E-mail : none (par défaut, la réinitialisation par e-mail est alors désactivée) | dev-outbox (développement seulement)
MAIL_DRIVER=none
